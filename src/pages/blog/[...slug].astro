---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const currentTags = new Set(post.data.tags ?? []);
const scoreRelatedPost = (candidate: CollectionEntry<'blog'>) => {
	let score = 0;

	if (post.data.series && candidate.data.series === post.data.series) {
		score += 40;
	}

	if (post.data.concept && candidate.data.concept === post.data.concept) {
		score += 50;
	}

	const sharedTags = (candidate.data.tags ?? []).filter((tag) => currentTags.has(tag)).length;
	score += sharedTags * 10;

	return score;
};

const relatedPosts = allPosts
	.filter((candidate) => candidate.id !== post.id)
	.map((candidate) => ({
		candidate,
		score: scoreRelatedPost(candidate),
	}))
	.sort((a, b) => b.score - a.score || b.candidate.data.pubDate.valueOf() - a.candidate.data.pubDate.valueOf())
	.slice(0, 3)
	.map(({ candidate }) => candidate);

const { Content } = await render(post);
---

<BlogPost {...post.data} relatedPosts={relatedPosts}>
	<Content />
</BlogPost>
