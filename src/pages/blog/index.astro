---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="All Posts" description="Every Al Brooks concept implemented and backtested in Python.">

  <div class="page-header">
    <div class="container">
      <div class="hero-label">Archive</div>
      <h1>All posts</h1>
    </div>
  </div>

  <div class="container" style="padding-bottom: 4rem;">
    {posts.length === 0 ? (
      <div class="empty-state"><p>First post coming soon</p></div>
    ) : (
      <div class="posts-grid">
        {posts.map((post) => (
          <a href={`/blog/${post.id}/`} class="post-card">
            <div class="post-card-top">
              {post.data.concept
                ? <span class="post-num">#{post.data.concept}</span>
                : <span></span>
              }
              <span class="post-date">
                {post.data.pubDate.toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' })}
              </span>
            </div>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="post-tags">
                {post.data.tags.map((tag: string) => <span class="tag">{tag}</span>)}
              </div>
            )}
          </a>
        ))}
      </div>
    )}
  </div>

</BaseLayout>
