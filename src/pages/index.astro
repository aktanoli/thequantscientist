---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
const posts = (await getCollection('blog')).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Home">
  <section class="hero">
    <div class="container">
      <div class="hero-kicker">The Quant Scientist</div>
      <h1>Al Brooks price action,<br /><em>measured in code.</em></h1>
      <p class="hero-desc">Learning Brooks from scratch and backtesting every concept in Python. No holy grails — just data, charts, and honest results.</p>
      <div class="hero-stats">
        <div class="stat"><span class="stat-val">{posts.length}</span><span class="stat-label">Concepts coded</span></div>
        <div class="stat"><span class="stat-val">10</span><span class="stat-label">Planned concepts</span></div>
        <div class="stat"><span class="stat-val">Python</span><span class="stat-label">Primary stack</span></div>
        <div class="stat"><span class="stat-val">ES · NQ</span><span class="stat-label">Instruments</span></div>
      </div>
    </div>
  </section>

  <section class="posts-section">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Latest posts</span>
        <a href="/blog" class="view-all">View all →</a>
      </div>
      {posts.length === 0 ? (
        <div class="empty-state"><p>First post coming soon</p></div>
      ) : (
        <div class="posts-grid">
          {posts.map(post => (
            <a href={`/blog/${post.id}/`} class="post-card">
              <div class="post-card-top">
                {post.data.concept ? <span class="concept-badge">#{post.data.concept}</span> : <span></span>}
                <span class="post-date">{post.data.pubDate.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</span>
              </div>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="post-tags">{post.data.tags.map((tag: string) => <span class="tag">{tag}</span>)}</div>
              )}
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
