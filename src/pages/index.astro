---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const brooksPosts  = allPosts.filter(p => p.data.concept);
const autopsyPosts = allPosts.filter(p => p.data.series === 'autopsy');
---

<BaseLayout title="Home">

  <!-- Hero -->
  <section class="hero">
    <div class="hero-grid-overlay" aria-hidden="true"></div>
    <div class="container">
      <div class="hero-kicker">The Quant Scientist</div>
      <h1>We test what<br /><em>traders believe.</em></h1>
      <p class="hero-desc">
        Al Brooks price action and popular trading strategies — coded in Python,
        backtested on real data, results shared honestly. No holy grails. Just numbers.
      </p>
      <div class="hero-stats">
        <div class="stat">
          <span class="stat-val">{allPosts.length}</span>
          <span class="stat-label">Posts published</span>
        </div>
        <div class="stat">
          <span class="stat-val">5</span>
          <span class="stat-label">Free tools</span>
        </div>
        <div class="stat">
          <span class="stat-val">Python</span>
          <span class="stat-label">Primary stack</span>
        </div>
        <div class="stat">
          <span class="stat-val" style="font-size:clamp(1rem,2.5vw,1.6rem);">ES · NQ · DAX · BTC</span>
          <span class="stat-label">Instruments covered</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Series 1: Al Brooks -->
  <section class="posts-section">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="section-label">Series 01</span>
          <h2 class="series-title">Al Brooks × Python</h2>
          <p class="series-desc">Every Brooks concept translated into code — one at a time. What the math says, what the backtest shows, and where the discretion lives.</p>
        </div>
        <a href="/blog" class="view-all">View all →</a>
      </div>

      <div class="posts-grid">
        {brooksPosts.length > 0 ? brooksPosts.slice(0, 3).map(post => (
          <a href={`/blog/${post.id}/`} class="post-card">
            <div class="post-card-top">
              {post.data.concept
                ? <span class="concept-badge">#{post.data.concept}</span>
                : <span></span>}
              <span class="post-date">
                {post.data.pubDate.toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' })}
              </span>
            </div>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            {post.data.tags && (
              <div class="post-tags">
                {post.data.tags.slice(0,3).map((t: string) => <span class="tag">{t}</span>)}
              </div>
            )}
          </a>
        )) : (
          <a href="/blog/buy_signal_bar/" class="post-card">
            <div class="post-card-top">
              <span class="concept-badge">#01</span>
              <span class="post-date">May 31, 2026</span>
            </div>
            <h2>I Coded Al Brooks' Buy Signal Bar in Python and Tested It on 23,000 Bars</h2>
            <p>What happens when you translate Brooks' most-used entry trigger into a strict mathematical formula and run it on real SPY data?</p>
            <div class="post-tags">
              <span class="tag">al-brooks</span>
              <span class="tag">signal-bars</span>
              <span class="tag">python</span>
            </div>
          </a>
        )}
        {brooksPosts.length < 2 && (
          <div class="post-card coming-soon-card">
            <div class="post-card-top">
              <span class="concept-badge">#02</span>
              <span class="coming-soon-label">Coming soon</span>
            </div>
            <h2>Trend vs. Trading Range Detection in Python</h2>
            <p>The most fundamental context layer in Brooks — can we define "always-in" direction with a mechanical rule?</p>
          </div>
        )}
        {brooksPosts.length < 3 && (
          <div class="post-card coming-soon-card">
            <div class="post-card-top">
              <span class="concept-badge">{brooksPosts.length < 2 ? '#03' : '#03'}</span>
              <span class="coming-soon-label">Coming soon</span>
            </div>
            <h2>Detecting the First Pullback — The 1PB Setup</h2>
            <p>Brooks' highest-probability entry. How often does it actually set up in trending markets?</p>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="series-divider"><div class="container"><hr /></div></div>

  <!-- Series 2: Backtest Autopsy -->
  <section class="posts-section">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="section-label">Series 02</span>
          <h2 class="series-title">Backtest Autopsy</h2>
          <p class="series-desc">Popular strategies put under the microscope. RSI, MACD, moving averages — tested on real data. No cherry-picking.</p>
        </div>
        <a href="/blog" class="view-all">View all →</a>
      </div>

      <div class="posts-grid">
        <div class="post-card coming-soon-card">
          <div class="post-card-top">
            <span class="autopsy-badge">Autopsy #01</span>
            <span class="coming-soon-label">Coming soon</span>
          </div>
          <h2>I Tested the RSI Strategy Everyone Teaches — Here's What Actually Happened</h2>
          <p>RSI overbought/oversold taught in every beginner course. 10 years of data. Does it work?</p>
        </div>
        <div class="post-card coming-soon-card">
          <div class="post-card-top">
            <span class="autopsy-badge">Autopsy #02</span>
            <span class="coming-soon-label">Coming soon</span>
          </div>
          <h2>The Golden Cross Myth — 200 EMA Backtested on 15 Years of Data</h2>
          <p>Every finance influencer swears by it. The data tells a more complicated story.</p>
        </div>
        <div class="post-card coming-soon-card">
          <div class="post-card-top">
            <span class="autopsy-badge">Autopsy #03</span>
            <span class="coming-soon-label">Coming soon</span>
          </div>
          <h2>Does "Cut Losses Short, Let Profits Run" Actually Work? A Python Test</h2>
          <p>The most repeated rule in trading — tested mechanically across 5,000 simulated trades.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="series-divider"><div class="container"><hr /></div></div>

  <!-- Tools section -->
  <section class="tools-section">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="section-label">Free tools</span>
          <h2 class="series-title">Built for serious traders</h2>
          <p class="series-desc">No login. No signup. Just open and use.</p>
        </div>
        <a href="/tools" class="view-all">All tools →</a>
      </div>

      <div class="tool-strip">
        <a href="/tools/risk-reward/" class="tool-strip-item">
          <span class="tool-arrow">↗</span>
          <div class="tool-strip-tag">Live</div>
          <div class="tool-strip-name">Risk / Reward Calculator</div>
          <p class="tool-strip-desc">Entry, stop, target → R:R ratio, position size, dollar risk, break-even win rate. Supports ES, NQ, stocks.</p>
        </a>
        <div class="tool-strip-item coming">
          <div class="tool-strip-tag dim">Soon</div>
          <div class="tool-strip-name">Backtest Stats Analyzer</div>
          <p class="tool-strip-desc">Paste your trade log — get Sharpe ratio, max drawdown, expectancy, and win rate breakdown.</p>
        </div>
        <div class="tool-strip-item coming">
          <div class="tool-strip-tag dim">Soon</div>
          <div class="tool-strip-name">ATR Position Sizer</div>
          <p class="tool-strip-desc">Size positions based on ATR — the volatility-adjusted way Brooks would think about risk.</p>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
