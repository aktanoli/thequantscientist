---
import BaseLayout from './BaseLayout.astro';
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  tags?: string[];
  concept?: string;
}
const { title, description, pubDate, updatedDate, tags = [], concept } = Astro.props;
const dateStr = pubDate.toLocaleDateString('en-US', { year:'numeric', month:'long', day:'numeric' });
---
<BaseLayout title={title} description={description}>
  <div id="read-progress" aria-hidden="true"></div>
  <article>
    <div class="article-hero">
      <div class="container">
        <div style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:1.25rem;">
          {concept && <span class="meta-badge" style="font-family:var(--mono);font-size:0.68rem;letter-spacing:0.08em;color:var(--accent);border:1px solid var(--accent);padding:0.2em 0.6em;border-radius:3px;">Concept #{concept}</span>}
          {tags.map(tag => <span class="tag">{tag}</span>)}
        </div>
        <h1>{title}</h1>
        <div class="article-meta">
          <span class="meta-item">Published <span>{dateStr}</span></span>
          <span class="meta-item">Series <span>Al Brooks × Python</span></span>
          <span class="meta-item">Read <span>6 min</span></span>
          {updatedDate && <span class="meta-item">Updated <span>{updatedDate.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</span></span>}
        </div>
      </div>
    </div>
    <div class="container">
      <div class="prose article-body">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  const bar = document.getElementById('read-progress');
  if (bar) {
    window.addEventListener('scroll', () => {
      const total = document.body.scrollHeight - window.innerHeight;
      bar.style.width = total > 0 ? (window.scrollY / total * 100) + '%' : '0%';
    }, { passive: true });
  }
</script>
