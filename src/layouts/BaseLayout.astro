---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Ticker from '../components/Ticker.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = SITE_DESCRIPTION, image } = Astro.props;
const fullTitle = title === 'Home' ? SITE_TITLE : `${title} — ${SITE_TITLE}`;
---

<!doctype html>
<html lang="en">
<head>
  <BaseHead title={fullTitle} description={description} />
</head>
<body>
  <Ticker />
  <Header />
  <main id="main-content">
    <slot />
  </main>
  <Footer />
</body>
</html>
