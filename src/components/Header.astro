---
const currentPath = Astro.url.pathname;
const isActive = (path: string) => {
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path);
};
---

<nav class="site-nav">
  <div class="nav-wrap">

    <a href="/" class="nav-logo" aria-label="The Quant Scientist home">
      <div class="nav-logo-mark" aria-hidden="true">TQS</div>
      <span>The Quant Scientist</span>
    </a>

    <ul class="nav-links" role="list">
      <li><a href="/" class={isActive('/') ? 'active' : ''}>Home</a></li>
      <li><a href="/blog" class={isActive('/blog') ? 'active' : ''}>Posts</a></li>
      <li><a href="/about" class={isActive('/about') ? 'active' : ''}>About</a></li>
      <li><a href="https://github.com/aktanoli/thequantscientist" target="_blank" rel="noopener">GitHub</a></li>
    </ul>

    <div class="nav-status" aria-hidden="true">
      <span class="status-dot"></span>
      <span>learning in public</span>
    </div>

  </div>
</nav>
